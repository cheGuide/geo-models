# Geo Models Deploy — переменные окружения
# Скопировать в .env и отредактировать

# Пути к репозиториям и данным (относительно deploy/ или абсолютные)
GAEA_PATH=../GAEA
GeoVista_PATH=../GeoVista
AnyLoc_PATH=../AnyLoc
# Веса для GeoVista: в контейнере /workspace/models/<GEOVISTA_MODEL>.
# ../models — каталог models рядом с deploy (например C:\...\models\models\GeoVista-RL-6k-7B).
# ./models — веса внутри deploy (deploy\models\...); тогда не путайте с ../models.
MODELS_PATH=../models
DATA_PATH=../data
OUTPUT_PATH=../outputs

# GeoVista vLLM
GEOVISTA_MODEL=GeoVista-RL-6k-7B
# Полный путь к весам внутри контейнера (если не задано: /workspace/models/${GEOVISTA_MODEL})
# Пример, если веса лежат в клоне GeoVista: GeoVista/models/...
# GEOVISTA_MODEL_PATH=/workspace/geovista/models/GeoVista-RL-6k-7B
GEOVISTA_PORT=8000
GEOVISTA_USE_QUANTIZATION=1

# GAEA finetune
GAEA_TRAIN_PATH=/workspace/gaea/data/ttk_train.json
GAEA_TEST_PATH=/workspace/gaea/data/ttk_test.json
GAEA_OUTPUT_DIR=/workspace/outputs/finetune_gaea_ttk

# GAEA Gradio: какой LoRA отдавать в UI
# Без ТТК: /workspace/models/GAEA
# После finetune_ttk (в том же OUTPUT_PATH): путь к final_lora внутри контейнера
# GAEA_SERVE_MODEL_PATH=/workspace/outputs/finetune_gaea_ttk/final_lora
# GAEA_LORA_PATH=/workspace/models/GAEA

# GeoAgent (LoRA TTK): путь к клону GeoAgent и имя образа после push в registry
GEOAGENT_PATH=../GeoAgent
# Локально: geo-deploy-geoagent:latest. Для pull с registry, например:
# GEOAGENT_IMAGE=ghcr.io/ВАШ_ОРГ/geoagent-train:latest
GEOAGENT_IMAGE=geo-deploy-geoagent:latest

# GPU
NVIDIA_VISIBLE_DEVICES=all
